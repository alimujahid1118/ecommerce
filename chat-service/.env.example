# Same MongoDB the e-commerce backend uses (the chat service reads the existing
# `users` collection and owns the `chat_conversations` / `chat_messages` collections).
MONGO_URI=

# MUST be identical to the e-commerce backend's JWT_SECRET, otherwise chat tokens
# issued by GET /api/chat/token cannot be verified here.
JWT_SECRET=

# Allowed browser origins (comma-separated for multiple), applied to both the
# REST API and the Socket.IO handshake.
# Dev:  http://localhost:5173
# Prod: https://my-ecommerce-site.com
CLIENT_URL=http://localhost:5173
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
LLM_HISTORY_LIMIT=20

PORT=5001
